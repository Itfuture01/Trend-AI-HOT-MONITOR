# ============ 服务 ============
PORT=3000
DATA_DIR=./data

# ============ AI（OpenRouter）============
# 必填，否则 AI 识别会降级为关键词匹配
OPENROUTER_API_KEY=
# 判定模型：勿用 *-free 免费版（分钟级限流→频繁降级）。deepseek/deepseek-chat 已确认可用
OPENROUTER_MODEL=deepseek/deepseek-chat

# ============ Twitter/X（twitterapi.io）============
# 可选，无 key 时该源自动跳过
TWITTERAPI_IO_KEY=

# ============ 邮件 SMTP ============
# 可选，无 host 则不发邮件
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=

# ============ 网络代理（可选）============
# 当前策略：默认直连，源连不上自动跳过（Bing/GitHub/360/百度等国内可直连）。
# 若你有本地代理（如 Clash 7890、V2rayN 10808），取消注释并按「http://」协议填写即可让
# Google/DDG/Reddit/V2EX 等被墙源恢复。注意 scheme 必须是 http://（写成 https:// 会无法识别）。
# 例：HTTP_PROXY=http://127.0.0.1:7890  HTTPS_PROXY=http://127.0.0.1:7890
#HTTP_PROXY=http://127.0.0.1:7890
#HTTPS_PROXY=http://127.0.0.1:7890

# ============ 调度间隔（分钟）============
MONITOR_INTERVAL_MIN=5
HOTSPOT_INTERVAL_MIN=15

# ============ 默认热点范围（热点聚合用）============
DEFAULT_RANGE=AI编程

# ============ AI 相关性阈值 (0~1) ============
AI_THRESHOLD=0.6

# ============ Web Push VAPID（首次启动自动生成，勿手改）============
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
