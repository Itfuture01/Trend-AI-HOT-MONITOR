# ============ 服务 ============
PORT=3000
DATA_DIR=./data

# ============ AI（OpenRouter）============
# 必填，否则 AI 识别会降级为关键词匹配
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# ============ Twitter/X（twitterapi.io）============
# 可选，无 key 时该源自动跳过
TWITTERAPI_IO_KEY=

# ============ 邮件 SMTP ============
# 可选，无 host 则不发邮件
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=

# ============ 调度间隔（分钟）============
MONITOR_INTERVAL_MIN=5
HOTSPOT_INTERVAL_MIN=15

# ============ 默认热点范围（热点聚合用）============
DEFAULT_RANGE=AI编程

# ============ AI 相关性阈值 (0~1) ============
AI_THRESHOLD=0.6

# ============ Web Push VAPID（首次启动自动生成，勿手改）============
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
